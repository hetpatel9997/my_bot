<?xml version="1.0"?>
<!--
  WeedBot body (CAD v21): bottom + top frame, body shell, drive wheels at the FRONT, stem caster at
  the BACK (the tail), electronics plate, spray tank at the back with the LD06 on top (on a puck),
  and the phone mount on a shelf on the front. The arm base sits on the top cover at the front
  (weedbot_arm.xacro); there is no lidar tower.
  Include from robot.urdf.xacro:
      <xacro:include filename="weedbot_properties.xacro"/>
      <xacro:include filename="weedbot_body.xacro"/>
      <xacro:include filename="weedbot_arm.xacro"/>
  with  <xacro:arg name="sim_mode" default="false"/>  declared before (the Gazebo caster is a
  frictionless sphere; the real one is the swivelling Krowne caster).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =============================== base =============================== -->
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_footprint"/>

  <!-- =============================== frame =============================== -->
  <xacro:property name="frame_l"   value="${frame_x_front-frame_x_rear}"/>
  <xacro:property name="frame_h"   value="${frame_top_z-frame_bottom_z}"/>
  <xacro:property name="top_dz"    value="${(top_frame_bottom_z+top_frame_top_z)/2 - (frame_bottom_z+frame_top_z)/2}"/>
  <xacro:property name="top_h"     value="${top_frame_top_z-top_frame_bottom_z}"/>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${(frame_x_rear+frame_x_front)/2} 0 ${(frame_bottom_z+frame_top_z)/2}" rpy="0 0 0"/>
  </joint>
  <link name="chassis">
    <!-- bottom frame: two side rails + front/rear cross rails + the 40x20 spine, 20 mm extrusions -->
    <visual>
      <origin xyz="0 ${frame_width/2-0.01} 0"/>
      <geometry><box size="${frame_l} 0.02 ${frame_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="0 ${-(frame_width/2-0.01)} 0"/>
      <geometry><box size="${frame_l} 0.02 ${frame_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="${frame_l/2-0.01} 0 0"/>
      <geometry><box size="0.02 ${frame_width} ${frame_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="${-frame_l/2+0.01} 0 0"/>
      <geometry><box size="0.02 ${frame_width} ${frame_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="${frame_l} 0.04 ${frame_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <!-- top frame: same x range, wider -->
    <visual>
      <origin xyz="0 ${top_frame_width/2-0.01} ${top_dz}"/>
      <geometry><box size="${frame_l} 0.02 ${top_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="0 ${-(top_frame_width/2-0.01)} ${top_dz}"/>
      <geometry><box size="${frame_l} 0.02 ${top_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="${frame_l/2-0.01} 0 ${top_dz}"/>
      <geometry><box size="0.02 ${top_frame_width} ${top_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="${-frame_l/2+0.01} 0 ${top_dz}"/>
      <geometry><box size="0.02 ${top_frame_width} ${top_h}"/></geometry>
      <material name="alu"/>
    </visual>
    <collision>
      <geometry><box size="${frame_l} ${frame_width} ${frame_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${frame_mass}"/>
      <xacro:box_inertia m="${frame_mass}" x="${frame_l}" y="${frame_width}" z="${frame_h}"/>
    </inertial>
  </link>

  <!-- top cover plate from the tank to the front of the top frame (visual only) -->
  <joint name="top_cover_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_cover"/>
    <origin xyz="${(tank_x1+frame_x_front)/2} 0 ${(top_frame_top_z+top_cover_z)/2}"/>
  </joint>
  <link name="top_cover">
    <visual><geometry><box size="${frame_x_front-tank_x1} ${top_frame_width} ${top_cover_z-top_frame_top_z}"/></geometry><material name="petg_blue"/></visual>
  </link>

  <!-- body shell around frame, wheels and electronics (see-through in RViz). Its outline is the
       Nav2 footprint between the phone mount and the caster (nav2_params.yaml, safety.yaml). -->
  <joint name="body_shell_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_shell"/>
    <origin xyz="${(body_x_rear+body_x_front)/2} 0 ${(body_bottom_z+body_top_z)/2}"/>
  </joint>
  <link name="body_shell">
    <visual><geometry><box size="${body_x_front-body_x_rear} ${body_width} ${body_top_z-body_bottom_z}"/></geometry><material name="shell"/></visual>
    <collision><geometry><box size="${body_x_front-body_x_rear} ${body_width} ${body_top_z-body_bottom_z}"/></geometry></collision>
    <inertial><mass value="${body_mass}"/><xacro:box_inertia m="${body_mass}" x="${body_x_front-body_x_rear}" y="${body_width}" z="${body_top_z-body_bottom_z}"/></inertial>
  </link>

  <!-- electronics plate on the deck (L298Ns under it) -->
  <joint name="ebox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ebox"/>
    <origin xyz="${(box_x0+box_x1)/2} 0 ${frame_top_z+box_h/2}"/>
  </joint>
  <link name="ebox">
    <visual><geometry><box size="${box_x1-box_x0} ${box_w} ${box_h}"/></geometry><material name="black"/></visual>
    <collision><geometry><box size="${box_x1-box_x0} ${box_w} ${box_h}"/></geometry></collision>
    <inertial><mass value="${box_mass}"/><xacro:box_inertia m="${box_mass}" x="${box_x1-box_x0}" y="${box_w}" z="${box_h}"/></inertial>
  </link>

  <!-- =============================== spray tank =============================== -->
  <!-- tank on the top frame at the back + sump below it (sump top = tank bottom). Mass = full tank,
       centre of mass at the volume-weighted middle of the two boxes. -->
  <xacro:property name="tank_cx" value="${(tank_x0+tank_x1)/2}"/>
  <xacro:property name="tank_cz" value="${(tank_z0+tank_z1)/2}"/>
  <xacro:property name="sump_cx" value="${(sump_x0+sump_x1)/2}"/>
  <xacro:property name="sump_cz" value="${(sump_z0+tank_z0)/2}"/>
  <xacro:property name="tank_v"  value="${(tank_x1-tank_x0)*tank_w*(tank_z1-tank_z0)}"/>
  <xacro:property name="sump_v"  value="${(sump_x1-sump_x0)*sump_w*(tank_z0-sump_z0)}"/>
  <joint name="spray_tank_joint" type="fixed">
    <parent link="base_link"/>
    <child link="spray_tank"/>
    <origin xyz="${tank_cx} 0 ${tank_cz}"/>
  </joint>
  <link name="spray_tank">
    <visual><geometry><box size="${tank_x1-tank_x0} ${tank_w} ${tank_z1-tank_z0}"/></geometry><material name="tank"/></visual>
    <visual>
      <origin xyz="${sump_cx-tank_cx} 0 ${sump_cz-tank_cz}"/>
      <geometry><box size="${sump_x1-sump_x0} ${sump_w} ${tank_z0-sump_z0}"/></geometry><material name="tank"/>
    </visual>
    <collision><geometry><box size="${tank_x1-tank_x0} ${tank_w} ${tank_z1-tank_z0}"/></geometry></collision>
    <collision>
      <origin xyz="${sump_cx-tank_cx} 0 ${sump_cz-tank_cz}"/>
      <geometry><box size="${sump_x1-sump_x0} ${sump_w} ${tank_z0-sump_z0}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${sump_v*(sump_cx-tank_cx)/(tank_v+sump_v)} 0 ${sump_v*(sump_cz-tank_cz)/(tank_v+sump_v)}"/>
      <mass value="${tank_mass}"/>
      <xacro:box_inertia m="${tank_mass}" x="${tank_x1-tank_x0}" y="${tank_w}" z="${tank_z1-tank_z0}"/>
    </inertial>
  </link>

  <!-- =========================== drive wheels (front) =========================== -->
  <!-- axle on the ground line of base_link: wheel centre at z = wheel_radius -->
  <xacro:macro name="drive_wheel" params="name joint side">
    <joint name="${joint}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${side*wheel_separation/2} ${wheel_radius}" rpy="${-side*pi/2} 0 0"/>
      <axis xyz="0 0 ${side}"/>
    </joint>
    <link name="${name}">
      <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
      <inertial><mass value="${wheel_mass}"/><xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/></inertial>
    </link>
    <!-- friction from the wheel_mu arg (launch_sim wheel_mu:=..., default 1.0); contact settings as the old robot_core.xacro -->
    <gazebo reference="${name}">
      <material>Gazebo/Black</material>
      <mu1 value="$(arg wheel_mu)"/><mu2 value="$(arg wheel_mu)"/>
      <fdir1 value="1 0 0"/><kp value="10000000.0"/><kd value="1.0"/><minDepth value="0.001"/>
    </gazebo>
  </xacro:macro>
  <!-- left: rpy -pi/2 puts the joint z along +y; right: rpy +pi/2 puts it along -y, so its axis is
       flipped (0 0 -1). Result: positive joint velocity = forward for BOTH wheels, which is what
       diff_drive_controller expects (this was the "forward spins the robot" fix in the sim). -->
  <xacro:drive_wheel name="left_wheel"  joint="${left_wheel_joint}"  side="1"/>
  <xacro:drive_wheel name="right_wheel" joint="${right_wheel_joint}" side="-1"/>

  <!-- 40T axle gears + cheeks, visual only -->
  <xacro:macro name="cheek" params="side">
    <joint name="cheek_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="cheek_${side}"/>
      <origin xyz="0 ${side*cheek_y} ${wheel_radius+0.02}"/>
    </joint>
    <link name="cheek_${side}">
      <visual><geometry><box size="0.087 0.006 0.09"/></geometry><material name="petg_orange"/></visual>
    </link>
  </xacro:macro>
  <xacro:cheek side="1"/>
  <xacro:cheek side="-1"/>

  <!-- =============================== caster at the back (the tail) =============================== -->
  <!-- bracket from the frame back to the stem socket (shape approximate, visual only) -->
  <joint name="caster_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_bracket"/>
    <origin xyz="${(frame_x_rear+caster_x-0.02)/2} 0 ${caster_mount_z-0.01}"/>
  </joint>
  <link name="caster_bracket">
    <visual><geometry><box size="${frame_x_rear-caster_x+0.02} 0.04 0.02"/></geometry><material name="petg_orange"/></visual>
  </link>
  <!-- stem socket from the swivel bearing up to the stem top -->
  <joint name="caster_socket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_socket"/>
    <origin xyz="${caster_x} 0 ${(caster_swivel_z+caster_mount_z)/2}"/>
  </joint>
  <link name="caster_socket">
    <visual><geometry><box size="0.03 0.03 ${caster_mount_z-caster_swivel_z}"/></geometry><material name="alu"/></visual>
  </link>

  <xacro:if value="$(arg sim_mode)">
    <!-- Gazebo: frictionless ball, same contact height as the real wheel -->
    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_wheel"/>
      <origin xyz="${caster_x} 0 ${caster_wheel_radius}"/>
    </joint>
    <link name="caster_wheel">
      <visual><geometry><sphere radius="${caster_wheel_radius}"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="${caster_wheel_radius}"/></geometry></collision>
      <inertial><mass value="0.3"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <gazebo reference="caster_wheel"><material>Gazebo/Black</material><mu1 value="0.001"/><mu2 value="0.001"/></gazebo>
  </xacro:if>
  <xacro:unless value="$(arg sim_mode)">
    <!-- real robot: swivel bearing, fork trailing behind the swivel axis (-x: driving forward the
         wheel trails toward the back, tail at caster_x - caster_trail - wheel radius = -0.519), wheel -->
    <xacro:property name="caster_drop" value="${caster_swivel_z-caster_wheel_radius}"/>
    <joint name="caster_swivel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="caster_swivel"/>
      <origin xyz="${caster_x} 0 ${caster_swivel_z}"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="caster_swivel">
      <visual><origin xyz="0 0 0.004"/><geometry><cylinder radius="0.025" length="0.008"/></geometry><material name="alu"/></visual>
      <visual>
        <origin xyz="${-caster_trail/2} 0 -0.004"/>
        <geometry><box size="${caster_trail+0.03} ${caster_wheel_width+0.024} 0.008"/></geometry>
        <material name="alu"/>
      </visual>
      <visual>
        <origin xyz="${-caster_trail} ${caster_wheel_width/2+0.006} ${-caster_drop/2}"/>
        <geometry><box size="0.02 0.006 ${caster_drop}"/></geometry>
        <material name="alu"/>
      </visual>
      <visual>
        <origin xyz="${-caster_trail} ${-(caster_wheel_width/2+0.006)} ${-caster_drop/2}"/>
        <geometry><box size="0.02 0.006 ${caster_drop}"/></geometry>
        <material name="alu"/>
      </visual>
      <inertial><mass value="0.4"/><inertia ixx="0.001" iyy="0.001" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="caster_wheel_joint" type="continuous">
      <parent link="caster_swivel"/>
      <child link="caster_wheel"/>
      <origin xyz="${-caster_trail} 0 ${-caster_drop}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="caster_wheel">
      <visual><geometry><cylinder radius="${caster_wheel_radius}" length="${caster_wheel_width}"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="${caster_wheel_radius}"/></geometry></collision>
      <inertial><mass value="0.3"/><xacro:cyl_inertia m="0.3" r="${caster_wheel_radius}" h="${caster_wheel_width}"/></inertial>
    </link>
  </xacro:unless>

  <!-- =============================== LD06 on the spray tank =============================== -->
  <!-- puck on the tank top, LD06 on the puck. In the scan plane (0.378) only the arm, in front of the
       LD06: ~+-10 deg blind straight ahead (removed by scan_self_filter). -->
  <joint name="lidar_puck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_puck"/>
    <origin xyz="${lidar_x} 0 ${puck_z0+puck_h/2}"/>
  </joint>
  <link name="lidar_puck">
    <visual><geometry><box size="${puck_size} ${puck_size} ${puck_h}"/></geometry><material name="petg_blue"/></visual>
    <collision><geometry><box size="${puck_size} ${puck_size} ${puck_h}"/></geometry></collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_body"/>
    <origin xyz="${lidar_x} 0 ${lidar_base_z+lidar_h/2}"/>
  </joint>
  <link name="lidar_body">
    <visual><geometry><cylinder radius="${lidar_dia/2}" length="${lidar_h}"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="${lidar_dia/2}" length="${lidar_h}"/></geometry></collision>
    <inertial><mass value="0.05"/><xacro:cyl_inertia m="0.05" r="${lidar_dia/2}" h="${lidar_h}"/></inertial>
  </link>
  <!-- the frame the scan is published in (ldlidar driver frame_id); x = the LD06's 0 deg mark (forward,
       lidar_yaw 0), z up, at the optical centre -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${lidar_frame}"/>
    <origin xyz="${lidar_x} 0 ${lidar_base_z+lidar_scan_dz}" rpy="0 0 ${lidar_yaw}"/>
  </joint>
  <link name="${lidar_frame}"/>

  <!-- =============================== phone mount =============================== -->
  <!-- shelf on the front of the body, wedge bracket on it (drawn as its bounding box), cradle slab
       tilted like the phone (perpendicular to the camera axis), visual only -->
  <joint name="phone_shelf_joint" type="fixed">
    <parent link="base_link"/>
    <child link="phone_shelf"/>
    <origin xyz="${(body_x_front+phone_shelf_x1)/2} 0 ${(phone_shelf_z0+phone_base_z)/2}"/>
  </joint>
  <link name="phone_shelf">
    <visual><geometry><box size="${phone_shelf_x1-body_x_front} ${phone_shelf_w} ${phone_base_z-phone_shelf_z0}"/></geometry><material name="petg_orange"/></visual>
  </link>
  <joint name="phone_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="phone_bracket"/>
    <origin xyz="${(phone_bracket_x+phone_bracket_x1)/2} 0 ${(phone_base_z+phone_bracket_z1)/2}"/>
  </joint>
  <link name="phone_bracket">
    <visual><geometry><box size="${phone_bracket_x1-phone_bracket_x} ${phone_bracket_w} ${phone_bracket_z1-phone_base_z}"/></geometry><material name="petg_orange"/></visual>
  </link>
  <!-- cradle: slab x = thickness, z = along the phone (leaning forward by phone_tilt from vertical);
       placed by its bounding box (x phone_cradle_x0..x1, top phone_cradle_z1) -->
  <xacro:property name="cradle_l" value="${(phone_cradle_x1-phone_cradle_x0-phone_cradle_t*cos(phone_tilt))/sin(phone_tilt)}"/>
  <joint name="phone_cradle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="phone_cradle"/>
    <origin xyz="${(phone_cradle_x0+phone_cradle_x1)/2} 0 ${phone_cradle_z1-(cradle_l*cos(phone_tilt)+phone_cradle_t*sin(phone_tilt))/2}"
            rpy="0 ${phone_tilt} 0"/>
  </joint>
  <link name="phone_cradle">
    <visual><geometry><box size="${phone_cradle_t} ${phone_cradle_w} ${cradle_l}"/></geometry><material name="petg_blue"/></visual>
  </link>
  <!-- phone_mount -> phone_optical -> phone_link at phone_xyz / phone_tilt (as phone_mount.xacro) -->
  <joint name="phone_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="phone_mount"/>
    <origin xyz="${phone_xyz}" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="phone_mount"/>
  <joint name="phone_optical_joint" type="fixed">
    <parent link="phone_mount"/>
    <child link="phone_optical"/>
    <origin xyz="0 0 0" rpy="${-phone_tilt} 0 0"/>
  </joint>
  <link name="phone_optical"/>
  <!-- the phone itself, behind the camera (screen facing back and up), centred on the robot's centre
       line; camera ~20 mm from its top and left edges. phone_optical: x right, y down, z = view -->
  <joint name="phone_body_joint" type="fixed">
    <parent link="phone_optical"/>
    <child link="phone_body"/>
    <origin xyz="${phone_xyz.split()[1]} 0.0158 -0.0041"/>
  </joint>
  <link name="phone_body">
    <visual><geometry><box size="0.1496 0.0715 0.0083"/></geometry><material name="phone"/></visual>
  </link>
  <joint name="phone_link_joint" type="fixed">
    <parent link="phone_optical"/>
    <child link="phone_link"/>
    <origin xyz="0 0 0" rpy="${pi} 0 ${-pi/2}"/>
  </joint>
  <link name="phone_link"/>

</robot>
