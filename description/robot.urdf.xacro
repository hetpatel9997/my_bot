<?xml version="1.0"?>
<!-- WeedBot (CAD v21): FRONT = the drive-wheel end, with the sprayer arm on the top cover and the
     phone mount on a shelf on the front; stem caster at the back, spray tank at the back with the LD06
     on top. All measurements: weedbot_properties.xacro (MEASURE markers).
     base_link = on the ground under the centre of the drive axle.
     Old files kept on disk but no longer included: robot_core.xacro, lidar.xacro, camera.xacro,
     phone_mount.xacro (the body defines phone_mount -> phone_optical -> phone_link itself). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

    <xacro:arg name="use_ros2_control" default="true"/>
    <xacro:arg name="sim_mode" default="false"/>
    <!-- Gazebo wheel friction (sim only; the real robot ignores <gazebo> tags). 1.0 = normal grip,
         e.g. 0.1 = slippery floor to show the EKF keeping the heading with the IMU. -->
    <xacro:arg name="wheel_mu" default="1.0"/>
    <!-- Kept because rsp.launch.py passes it; unused since camera.xacro is no longer included
         (the phone is the camera now). -->
    <xacro:arg name="sim_camera" default="false"/>

    <!-- used by imu.xacro (was defined in the old robot_core.xacro) -->
    <material name="blue"><color rgba="0.2 0.2 1 1"/></material>

    <xacro:include filename="weedbot_properties.xacro"/>
    <xacro:include filename="weedbot_body.xacro"/>
    <xacro:include filename="weedbot_arm.xacro"/>

    <!--<xacro:include filename="gazebo_control.xacro"/>-->
    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="ros2_control.xacro"/>
    </xacro:if>
    <xacro:unless value="$(arg use_ros2_control)">
        <xacro:include filename="gazebo_control.xacro"/>
    </xacro:unless>
    <xacro:include filename="imu.xacro"/>
    <xacro:if value="$(arg sim_mode)">
        <xacro:include filename="imu_sim.xacro"/>
        <xacro:include filename="lidar_sim.xacro"/>
        <xacro:include filename="sim_ground_truth.xacro"/>
    </xacro:if>

</robot>
