<?xml version="1.0"?>
<!--
  Sprayer arm on the top cover at the FRONT of the robot (over the drive wheels, CAD v21):
  4 x MG996R + a wrist roll.
    arm_base_yaw   : servo 1, hangs under the base plate in front of the axis and turns the arm (and
                     its round base housing) through a gear, about the vertical axis at arm_x
                     (yaw range: MEASURE)
    shoulder_pitch : servo 2
    elbow_pitch    : servo 3
    wrist_pitch    : servo 4
    wrist_roll     : servo 5, arm_roll_d along the last link, turns the nozzle about the link
                     (link spray_tip = where the spray leaves)
  Zero position = arm pointing straight up. Positive pitch tilts forward (toward the phone).
  Each joint: -90..+90 deg (the servo's 180 deg travel centred). Link lengths (axis to axis) are in
  weedbot_properties.xacro (arm_l1..l4, arm_roll_d, CAD v21). Masses: MEASURE.
  In RViz, move it with joint_state_publisher_gui; on the robot the servo driver publishes the same
  joint names on /joint_states.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo has no servos for the arm yet: with revolute joints the arm collapsed under gravity
       (forearm hanging through the LiDAR scan plane) while TF still showed it straight up. In sim
       the five joints are FIXED in the parked pose (arm_park_*, the joint origins carry the angles;
       = what arm_joint_state_stub.py reports on the robot); on the robot they are servo joints at 0
       in the origins. Give them a simulated position controller before moving the arm in sim. -->
  <xacro:if value="$(arg sim_mode)">
    <xacro:property name="arm_joint_type" value="fixed"/>
    <xacro:property name="q_yaw" value="${arm_park_yaw}"/>
    <xacro:property name="q_shoulder" value="${arm_park_shoulder}"/>
    <xacro:property name="q_elbow" value="${arm_park_elbow}"/>
    <xacro:property name="q_wrist" value="${arm_park_wrist}"/>
    <xacro:property name="q_roll" value="${arm_park_roll}"/>
  </xacro:if>
  <xacro:unless value="$(arg sim_mode)">
    <xacro:property name="arm_joint_type" value="revolute"/>
    <xacro:property name="q_yaw" value="0"/>
    <xacro:property name="q_shoulder" value="0"/>
    <xacro:property name="q_elbow" value="0"/>
    <xacro:property name="q_wrist" value="0"/>
    <xacro:property name="q_roll" value="0"/>
  </xacro:unless>

  <xacro:property name="servo_x" value="0.0407"/>
  <xacro:property name="servo_y" value="0.0197"/>
  <xacro:property name="servo_z" value="0.0429"/>

  <xacro:macro name="servo_visual" params="xyz rpy">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${servo_x} ${servo_y} ${servo_z}"/></geometry>
      <material name="servo"/>
    </visual>
  </xacro:macro>

  <!-- arm link: a bar along +z of length L, with the next servo at its end. scan_w = width (y) of the
       collision box (wider than the bar only where the LD06 sees the arm, see arm_scan_w) -->
  <xacro:macro name="arm_link" params="name length mass scan_w:=${link_w}">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}"/>
        <geometry><box size="${link_w} ${link_w} ${length}"/></geometry>
        <material name="petg_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}"/>
        <geometry><box size="${link_w} ${scan_w} ${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}"/>
        <mass value="${mass}"/>
        <xacro:box_inertia m="${mass}" x="${link_w}" y="${link_w}" z="${length}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- base plate set into the top cover (top = cover top = yaw joint); the yaw servo hangs under it -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="${arm_x} 0 ${arm_base_z+arm_plate_t/2}"/>
  </joint>
  <link name="arm_base">
    <visual><geometry><cylinder radius="${arm_plate_r}" length="${arm_plate_t}"/></geometry><material name="petg_blue"/></visual>
    <collision><geometry><cylinder radius="${arm_plate_r}" length="${arm_plate_t}"/></geometry></collision>
    <inertial><mass value="0.15"/><xacro:cyl_inertia m="0.15" r="${arm_plate_r}" h="${arm_plate_t}"/></inertial>
  </link>

  <!-- yaw servo (servo 1) under the plate (inside the body), arm_yaw_servo_dx in front of the axis,
       shaft up into the gear -->
  <joint name="arm_yaw_servo_joint" type="fixed">
    <parent link="arm_base"/>
    <child link="arm_yaw_servo"/>
    <origin xyz="${arm_yaw_servo_dx} 0 ${-arm_plate_t/2-servo_z/2}"/>
  </joint>
  <link name="arm_yaw_servo"><xacro:servo_visual xyz="0 0 0" rpy="0 0 0"/></link>

  <!-- servo 1: yaw -->
  <joint name="arm_base_yaw" type="${arm_joint_type}">
    <parent link="arm_base"/>
    <child link="arm_turret"/>
    <origin xyz="0 0 ${arm_plate_t/2}" rpy="0 0 ${q_yaw}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-servo_limit}" upper="${servo_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>
  <!-- turning part: round base housing on the cover + the post up to the shoulder -->
  <link name="arm_turret">
    <visual><origin xyz="0 0 ${arm_l1/2}"/><geometry><box size="${link_w} ${link_w} ${arm_l1}"/></geometry><material name="petg_blue"/></visual>
    <visual><origin xyz="0 0 ${arm_housing_h/2}"/><geometry><cylinder radius="${arm_plate_r}" length="${arm_housing_h}"/></geometry><material name="petg_blue"/></visual>
    <collision><origin xyz="0 0 ${arm_housing_h/2}"/><geometry><cylinder radius="${arm_plate_r}" length="${arm_housing_h}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${arm_l1/2}"/><mass value="0.09"/><xacro:box_inertia m="0.09" x="${servo_x}" y="${servo_y}" z="${arm_l1}"/></inertial>
  </link>

  <!-- servo 2 (shoulder) body at the top of the post -->
  <joint name="turret_servo_joint" type="fixed"><parent link="arm_turret"/><child link="turret_servo"/><origin xyz="0 0 0"/></joint>
  <link name="turret_servo">
    <xacro:servo_visual xyz="0 0 ${arm_l1-servo_z/2+0.005}" rpy="0 0 0"/>
  </link>

  <!-- servo 2: shoulder -->
  <joint name="shoulder_pitch" type="${arm_joint_type}">
    <parent link="arm_turret"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 ${arm_l1}" rpy="0 ${q_shoulder} 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-servo_limit}" upper="${servo_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>
  <xacro:arm_link name="upper_arm" length="${arm_l2}" mass="0.08" scan_w="${arm_scan_w}"/>

  <!-- servo 3: elbow -->
  <joint name="elbow_pitch" type="${arm_joint_type}">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 ${arm_l2}" rpy="0 ${q_elbow} 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-servo_limit}" upper="${servo_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>
  <xacro:arm_link name="forearm" length="${arm_l3}" mass="0.07"/>

  <!-- servo 4: wrist pitch -->
  <joint name="wrist_pitch" type="${arm_joint_type}">
    <parent link="forearm"/>
    <child link="wrist"/>
    <origin xyz="0 0 ${arm_l3}" rpy="0 ${q_wrist} 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-servo_limit}" upper="${servo_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>
  <link name="wrist">
    <visual><origin xyz="0 0 ${arm_roll_d/2}"/><geometry><box size="${link_w} ${link_w} ${arm_roll_d}"/></geometry><material name="petg_blue"/></visual>
    <collision><origin xyz="0 0 ${arm_roll_d/2}"/><geometry><box size="${servo_x} ${servo_y} ${arm_roll_d+servo_z}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${arm_roll_d/2}"/><mass value="0.1"/><xacro:box_inertia m="0.1" x="${servo_x}" y="${servo_y}" z="${arm_roll_d}"/></inertial>
  </link>

  <!-- servo 4 body at the wrist pitch axis and servo 5 (wrist roll) body, shaft along the link at the
       roll joint (size approximate), visual only -->
  <joint name="wrist_servos_joint" type="fixed"><parent link="wrist"/><child link="wrist_servos"/><origin xyz="0 0 0"/></joint>
  <link name="wrist_servos">
    <xacro:servo_visual xyz="0 0 0" rpy="0 0 0"/>
    <visual><origin xyz="0 0 ${arm_roll_d-servo_x/2}"/><geometry><box size="${servo_y} ${servo_z} ${servo_x}"/></geometry><material name="servo"/></visual>
  </link>

  <!-- servo 5: wrist roll, turns the nozzle about the link axis -->
  <joint name="wrist_roll" type="${arm_joint_type}">
    <parent link="wrist"/>
    <child link="nozzle"/>
    <origin xyz="0 0 ${arm_roll_d}" rpy="0 0 ${q_roll}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-servo_limit}" upper="${servo_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>
  <link name="nozzle">
    <visual><origin xyz="0 0 ${(arm_l4-arm_roll_d)/2}"/><geometry><cylinder radius="0.006" length="${arm_l4-arm_roll_d}"/></geometry><material name="alu"/></visual>
    <collision><origin xyz="0 0 ${(arm_l4-arm_roll_d)/2}"/><geometry><cylinder radius="0.006" length="${arm_l4-arm_roll_d}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${(arm_l4-arm_roll_d)/2}"/><mass value="0.02"/><xacro:cyl_inertia m="0.02" r="0.006" h="${arm_l4-arm_roll_d}"/></inertial>
  </link>

  <!-- where the spray comes out, z pointing along the nozzle -->
  <joint name="spray_tip_joint" type="fixed">
    <parent link="nozzle"/>
    <child link="spray_tip"/>
    <origin xyz="0 0 ${arm_l4-arm_roll_d}"/>
  </joint>
  <link name="spray_tip">
    <visual><geometry><sphere radius="0.006"/></geometry><material name="petg_orange"/></visual>
  </link>

  <!-- servo bodies at the shoulder and elbow (on the parent link, visual only) -->
  <joint name="shoulder_servo_joint" type="fixed"><parent link="upper_arm"/><child link="shoulder_servo"/><origin xyz="0 ${link_w/2+servo_y/2} 0"/></joint>
  <link name="shoulder_servo"><xacro:servo_visual xyz="0 0 0" rpy="${pi/2} 0 0"/></link>
  <joint name="elbow_servo_joint" type="fixed"><parent link="forearm"/><child link="elbow_servo"/><origin xyz="0 ${link_w/2+servo_y/2} 0"/></joint>
  <link name="elbow_servo"><xacro:servo_visual xyz="0 0 0" rpy="${pi/2} 0 0"/></link>

</robot>
