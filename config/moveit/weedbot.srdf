<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoveIt 2 semantic description of the WeedBot spray arm (loaded by launch/arm_aim.launch.py).
  The URDF (description/robot.urdf.xacro) says what the robot IS; this file says how MoveIt should
  USE it: which joints form the arm, its named poses, and which part pairs never need a
  collision check.
  The robot name must match the URDF's name ("robot"), or MoveIt warns that the two files
  describe different robots.
-->
<robot name="robot">

  <!-- The arm: everything from the base plate in the top cover to the nozzle tip. A chain gives
       exactly the 5 servos: arm_base_yaw, shoulder_pitch, elbow_pitch, wrist_pitch, wrist_roll.
       The wheels are not in it: MoveIt never drives the robot. -->
  <group name="arm">
    <chain base_link="arm_base" tip_link="spray_tip"/>
  </group>

  <!-- Parked pose, the same angles as arm_park_* in weedbot_properties.xacro and the real-robot
       joint-state stub (test_moveit_config.py checks all three agree): forearm forward and
       horizontal (elbow +90 deg), nozzle pointing down (wrist +90 deg), others 0.
       scripts/arm_config.py load_park() reads it from here. -->
  <group_state name="park" group="arm">
    <joint name="arm_base_yaw" value="0.0"/>
    <joint name="shoulder_pitch" value="0.0"/>
    <joint name="elbow_pitch" value="1.5707963268"/>
    <joint name="wrist_pitch" value="1.5707963268"/>
    <joint name="wrist_roll" value="0.0"/>
  </group_state>

  <!-- Part pairs that touch BY DESIGN (bolted together, or joined by one joint), so MoveIt does
       not call them collisions. Do not edit by hand: made by test/arm_aim/gen_disable_collisions.py
       (after a URDF change run it with its write option, see its header, which also explains
       why each pair is here). Every
       other pair is checked, e.g. the nozzle or forearm against the body, tank or LiDAR. -->
  <!-- BEGIN generated -->
  <disable_collisions link1="arm_base" link2="arm_turret" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="body_shell" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="chassis" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="ebox" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="arm_base" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="body_shell" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="chassis" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="ebox" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="upper_arm" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="chassis" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="ebox" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="body_shell" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="chassis" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="ebox" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="caster_wheel" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="ebox" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="chassis" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="ebox" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="ebox" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="ebox" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="ebox" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="ebox" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="forearm" link2="upper_arm" reason="Adjacent"/>
  <disable_collisions link1="forearm" link2="wrist" reason="Adjacent"/>
  <disable_collisions link1="left_wheel" link2="lidar_body" reason="Adjacent"/>
  <disable_collisions link1="left_wheel" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="left_wheel" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="lidar_body" link2="lidar_puck" reason="Adjacent"/>
  <disable_collisions link1="lidar_body" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="lidar_body" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="lidar_puck" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="lidar_puck" link2="spray_tank" reason="Adjacent"/>
  <disable_collisions link1="nozzle" link2="wrist" reason="Adjacent"/>
  <disable_collisions link1="right_wheel" link2="spray_tank" reason="Adjacent"/>
  <!-- END generated -->

</robot>
