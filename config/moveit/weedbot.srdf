  <disable_collisions link1="arm_turret" link2="phone_body" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="phone_bracket" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="phone_cradle" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="phone_shelf" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="shoulder_servo" reason="Adjacent"/>
  <disable_collisions link1="arm_turret" link2="spray_tank" reason="Adjacent"/>
