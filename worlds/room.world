<?xml version="1.0" ?>
<!-- room.world: 5 x 4 m room with a table-sized and a couch-sized box, for SLAM / Nav2 /
     coverage planner tests. Robot spawns at the origin (room centre). Generated by a script;
     edit sizes/poses directly if needed. -->
<sdf version="1.6">
  <world name="room">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>2.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="table">
      <static>true</static>
      <pose>1.5 1.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="couch">
      <static>true</static>
      <pose>-1.2 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.9 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.9 0.8</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
